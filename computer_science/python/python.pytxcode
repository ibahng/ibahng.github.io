        import math

        # Rounding and Absolute Value ----------
        print(math.floor(7.9))       # floor
        print(math.ceil(8.2))        # ceiling
        print(math.fabs(-2.2))       # absolute value as float

        # Power and Root
        print(math.sqrt(9))          # square root
        print(math.pow(2, 8))        # x^y as float

        # Exponential and Logarithmic ----------
        print(math.exp(1))           # e^x
        print(math.log(math.e))      # natural logarithm (base e)
        print(math.log(100, 10))     # logarithm to specified base
        print(math.log2(8))          # base-2 logarithm
        print(math.log10(1000))      # base-10 logarithm

        # Trigonometric ------------------------
        print(math.sin(math.pi/2))   # sine of x in radians
        print(math.degrees(math.pi)) # radians to degrees
        print(math.radians(180))     # degrees to radians

        # Combinatorial ------------------------
        print(math.factorial(5))     # n!
        print(math.comb(10, 3))      # n choose k
        print(math.perm(10, 3))      # ordered arrangements of k from n


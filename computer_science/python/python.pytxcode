        import os
        import shutil
        shutil.rmtree('./sandbox', ignore_errors=True) # recursively deletes the entire sandbox directory tree if it exists; this is in order to start with a clean slate

        os.makedirs('./sandbox') # making sandbox/
        os.chdir('./sandbox') # moving to python/sandbox/
        print(os.listdir('.')) # seeing the contents of sandbox/

        os.mkdir('test_dir') # making sandbox/test_dir/
        print(os.listdir('.')) # seeing the contents of sandbox/test_dir/

        os.rename('test_dir', 'renamed_dir') # renaming sandbox/test_dir/ to sandbox/renamed_dir/
        print(os.listdir('.')) # seeing the contents of sandbox/

        os.makedirs('renamed_dir/sub_parent/child') # making sandbox/renamed_dir/sub_parent/child/
        print(os.listdir('renamed_dir')) # seeing the contents of sandbox/renamed_dir/

        with open('renamed_dir/sub_parent/child/temp.txt', 'w') as f:
            f.write('Clean up test')

        print(os.listdir('renamed_dir/sub_parent/child')) # seeing the contents of child/

        os.remove('renamed_dir/sub_parent/child/temp.txt') # deleting child/temp.txt
        print(os.listdir('renamed_dir/sub_parent/child')) # seeing the contents of child/

        os.rmdir('renamed_dir/sub_parent/child') # deleting empty child/
        print(os.listdir('renamed_dir/sub_parent')) # seeing the contents of sub_parent/

        os.chdir('..') # moving back to python/

